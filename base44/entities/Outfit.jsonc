{
  "name": "Outfit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the outfit"
    },
    "description": {
      "type": "string",
      "description": "Description or notes about the outfit"
    },
    "clothing_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of clothing item IDs that make up this outfit"
    },
    "occasion": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "casual",
          "business",
          "formal",
          "athletic",
          "party"
        ]
      },
      "description": "Suitable occasions for this outfit"
    },
    "season": {
      "type": "string",
      "enum": [
        "spring",
        "summer",
        "fall",
        "winter",
        "all"
      ],
      "description": "Best season for this outfit"
    },
    "favorite": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a favorite outfit"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether this outfit is visible to other users"
    }
  },
  "required": [
    "name",
    "clothing_items"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": {
      "$or": [
        {
          "is_public": true
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}