{
  "name": "ClothingItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "chaquetas",
        "gabanes",
        "chalecos",
        "pantalones",
        "parka",
        "sudaderas",
        "blusas",
        "blazer",
        "calzado",
        "vestidos",
        "faldas"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "season": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occasion": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "fabric": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "image_url"
  ]
}